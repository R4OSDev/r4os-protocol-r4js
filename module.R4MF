R4OS_MODULE_MANIFEST=2
KIND=R4P
NAME=R4JS
VERSION=0.54.4
LANGUAGE=Zig
SOURCE=src/main.zig
TARGET=/R4OS/PROTOCOLS/R4JS.R4P
IMAGE_SCOPE=full
IMPORT=R4DEV:Query:1
